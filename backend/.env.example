# TeamTalk Backend Environment Configuration

# Server
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:80,http://localhost"

# Database (PostgreSQL 16 with UTF-8 encoding)
DATABASE_URL="postgresql://teamtalk:teamtalk_secret_pass@localhost:5432/teamtalk?schema=public"

# Redis Cache & Realtime Presence
REDIS_URL="redis://localhost:6379"

# Security & Application-Layer Encryption at Rest
# AT_REST_ENCRYPTION_KEY must be a 64-character hex string (256-bit AES-GCM key)
AT_REST_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="super_secret_jwt_key_at_least_32_chars_long_teamtalk"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS="30"

# coturn TURN Server REST API Credentials (HMAC-SHA1)
TURN_SECRET="teamtalk_turn_secret_change_in_production_9f81a7b"
TURN_REALM="teamtalk.internal"
TURN_URLS="turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp"
STUN_URLS="stun:localhost:3478,stun:stun.l.google.com:19302"

# Storage Driver (local or s3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"

# S3 Storage (Optional: when STORAGE_DRIVER="s3")
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="teamtalk-files"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin_secret_key"
S3_FORCE_PATH_STYLE="true"

# Antivirus Scanning (Optional ClamAV INSTREAM hook)
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# Push Notifications (Firebase Cloud Messaging)
# FCM_PROJECT_ID="teamtalk-fcm"
# FCM_CLIENT_EMAIL="firebase-adminsdk@teamtalk-fcm.iam.gserviceaccount.com"
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...-----END PRIVATE KEY-----\n"
